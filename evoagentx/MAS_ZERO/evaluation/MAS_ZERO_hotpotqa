import json
import os 
from dotenv import load_dotenv
from tqdm import tqdm

from evoagentx.core.logging import logger
from evoagentx.models import OpenAILLMConfig, OpenAILLM, SiliconFlowConfig, SiliconFlowLLM
from evoagentx.benchmark import benchmark, HotPotQA
from evoagentx.MAS_ZERO.MAS_ZERO import MAS_ZERO

load_dotenv()
OPENAI_API_KEY_O = os.getenv("OPENAI_API_KEY_O")
OPENAI_API_KEY_E = os.getenv("OPENAI_API_KEY_E")
SILICONFLOW_API_KEY_O = os.getenv("SILICONFLOW_API_KEY_O")
SILICONFLOW_API_KEY_E = os.getenv("SILICONFLOW_API_KEY_E")

def execute(benchmark: benchmark, mz: MAS_ZERO, interation_num: int = 5, verbose: bool = True):
    """
    Run MAS-ZERO on a subset of the benchmark test data concurrently and compute average F1.

    Args:
        benchmark: Benchmark dataset instance (e.g., HotPotQA)
        mz: MAS_ZERO system instance
        max_concurrent_tasks: Max number of concurrent evaluations

    Returns:
        (avg_f1, all_failed): Tuple of average F1 score and whether all tasks failed
    """
    benchmark._load_data()
    import numpy as np
    np.random.seed(42)
    permutation = np.random.permutation(len(benchmark._dev_data))
    full_test_data = benchmark._dev_data
    data = [full_test_data[idx] for idx in permutation[50:150]]

    if not data:
        logger.warning("No data to evaluate. Returning zeros.")
        return 0.0, True
    
    results_f1 = []
    results_em = []
    results_acc = []
    iterator = tqdm(data, desc=f"Evaluating {benchmark.name} problems", ncols=100) if verbose else data

    for example in iterator:
        question = example["question"]
        paragraphs = [item[1] for item in example["context"] if isinstance(item[1], list)]
        context_str = "\n".join(" ".join(paragraph) for paragraph in paragraphs)
        instr = """ 
        - Your answer must be concise and extracted from the given context.
        - Do not include explanations or restate the question.
        - You may reason internally, but only output the final answer phrase.
            - If the answer is "yes" or "no", output exactly "yes" or "no".
            - If the answer is a number, output it exactly as it appears in the context.
            - If the answer is an entity or phrase, output it exactly as it appears in the context.
        - Do not output "[Not found]" or similar placeholders — always output the best possible phrase from the context.).
        """
        goal = f"Context: {context_str}\n\nQuestion: {question}\n\n{instr}\n\nAnswer:"
        # goal = f"Context: {context_str}\n\nQuestion: {question}\n\nAnswer:"
        if not goal:
                logger.warning("Missing 'question' field in example.")
        
        try:
            prediction = mz.execute(goal=goal, iteration_num=interation_num)
            label = benchmark.get_label(example)
            metrics = benchmark.evaluate(prediction, label)
            f1 = metrics.get("f1", 0.0)
            em = metrics.get("em", 0.0)
            acc = metrics.get("acc", 0.0)

            if f1 < 1.0:
                fail_record = {
                    "goal" : goal,
                    "prediction": prediction,
                    "label": label,
                    "metrics": metrics
                }
                log_path = "MAS_ZERO/record/failed_cases_3.json"

                os.makedirs(os.path.dirname(log_path), exist_ok=True)

                if os.path.exists(log_path):
                    try:
                        with open(log_path, "r", encoding="utf-8") as f:
                            data = json.load(f)
                    except json.JSONDecodeError:
                        data = []
                else:
                    data = []

                data.append(fail_record)

                with open(log_path, "w", encoding="utf-8") as f:
                    json.dump(data, f, indent=2, ensure_ascii=False)

                logger.warning(f"Recorded failed case (F1={f1}) to {log_path}")


            logger.info(f"Evaluated question: {question[:50]}... | Prediction: {prediction} | Label: {label} | F1: {f1:.3f}")
            results_f1.append(f1)
            results_em.append(em)
            results_acc.append(acc)

        except Exception as e:
            logger.warning(f"Failed on evaluating question {question[:50]}... : {e}")
            results_f1.append(None)
            results_em.append(None)
            results_acc.append(None)

    # Handle invalid results
    valid_results_f1 = [0.0 if r is None else r for r in results_f1]
    valid_results_em = [0.0 if r is None else r for r in results_em]
    valid_results_acc = [0.0 if r is None else r for r in results_acc]
    all_failed_f1 = all(r is None for r in results_f1)

    if not valid_results_f1:
        logger.warning("No valid results. Returning zeros.")
        avg_metrics_f1 = 0.0
    else:
        avg_metrics_f1 = sum(valid_results_f1) / len(valid_results_f1)

    if not valid_results_em:
        logger.warning("No valid results. Returning zeros.")
        avg_metrics_em = 0.0
    else:
        avg_metrics_em = sum(valid_results_em) / len(valid_results_em)

    if not valid_results_acc:
        logger.warning("No valid results. Returning zeros.")
        avg_metrics_acc = 0.0
    else:
        avg_metrics_acc = sum(valid_results_acc) / len(valid_results_acc)

    logger.info(f"Evaluation complete. Average F1: {avg_metrics_f1:.3f}, Average EM: {avg_metrics_em:.3f}, Average ACC: {avg_metrics_acc:.3f}")
    return avg_metrics_f1, all_failed_f1

def main():
    """Main entry point to run MAS-ZERO evaluation on HotPotQA benchmark."""
    logger.info("Initializing models and benchmark...")

    optimizer_config = SiliconFlowConfig(
        model="Pro/deepseek-ai/DeepSeek-V3.1-Terminus",
        siliconflow_key=SILICONFLOW_API_KEY_O,
        temperature=0.8,
        max_tokens=1000)
    optimizer_llm = SiliconFlowLLM(config=optimizer_config)

    executor_config = SiliconFlowConfig(
        model="Pro/deepseek-ai/DeepSeek-V3",
        siliconflow_key=SILICONFLOW_API_KEY_E,
        temperature=0.4,
        max_tokens=1000)
    executor_llm = SiliconFlowLLM(config=executor_config)

    # optimizer_config  = OpenAILLMConfig(
    #     model="gpt-4o",
    #     openai_key= OPENAI_API_KEY_O,
    #     temperature=0.8,
    #     max_tokens=1000)
    # optimizer_llm = OpenAILLM(config=optimizer_config)

    # executor_config = OpenAILLMConfig(
    #     model="gpt-4o-mini",
    #     openai_key= OPENAI_API_KEY_E,
    #     temperature=0.4,
    #     max_tokens=1000)
    # executor_llm = OpenAILLM(config=executor_config)

    # Initialize MAS-ZERO system
    mz = MAS_ZERO(optimizer_llm=optimizer_llm, executor_llm=executor_llm)
    benchmark = HotPotQA()

    # Run async evaluation
    logger.info("Starting evaluation process...")
    avg_f1, all_failed = execute(benchmark=benchmark, mz=mz, interation_num=3)

    # logger.info(f"Final Average F1 Score on HotPotQA: {avg_f1:.3f}")
    logger.info(f"All examples failed? {all_failed}")

if __name__ == "__main__":
    main()